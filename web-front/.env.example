# Base URL of the backend API (must end in /api)
VITE_API_URL=http://localhost:3100/api

# Base URL of the backend's Socket.IO server (no /api suffix)
VITE_SOCKET_URL=http://localhost:3100

# Free key from https://www.omdbapi.com/apikey.aspx (movie search module)
VITE_OMDB_API_KEY=

# Free key from https://developers.giphy.com/dashboard/ (GIF search module)
VITE_GIPHY_API_KEY=
