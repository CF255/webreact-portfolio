# MongoDB Atlas connection string
DB_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=cluster

# JWT secrets (use long random strings, different for each)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Comma-separated list of origins allowed to call the API / connect via Socket.IO
# http://localhost:5173 is the Vite dev server, :8080 is the docker-compose frontend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional, defaults to 3100
PORT=3100
